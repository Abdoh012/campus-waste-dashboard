# Think Outside The Box API — environment configuration.
# Copy to `.env` (git-ignored) and adjust. Every value has a working default
# for local development except JWT_SECRET in production.

# --- Server ---------------------------------------------------------------
PORT=5000
NODE_ENV=development

# --- MongoDB --------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/campus_waste

# --- Auth -----------------------------------------------------------------
# Signing secret for dashboard JWTs. REQUIRED when NODE_ENV=production;
# without it the server refuses to start. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long a dashboard login stays valid.
JWT_EXPIRES_IN=7d

# --- CORS -----------------------------------------------------------------
# '*' (default) or a comma-separated allowlist, e.g.:
# CORS_ORIGIN=http://localhost:5173,https://ops.example.edu
CORS_ORIGIN=*

# --- Bin behaviour --------------------------------------------------------
# A bin whose lastSyncAt is older than this reads back as `offline`.
OFFLINE_THRESHOLD_MINUTES=5

# Optional shared secret for ESP32 ingest (PUT /api/bins/:deviceId/status).
# Leave empty to accept ingest without a key (the device contract has no
# auth header); set a value to require `X-Device-Key: <value>`.
DEVICE_INGEST_KEY=

# --- Seed script (npm run seed) ------------------------------------------
SEED_ADMIN_EMAIL=admin@batu.edu.eg
# Leave empty to have the seed script generate one and print it.
SEED_ADMIN_PASSWORD=
